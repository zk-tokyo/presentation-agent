{
  "name": "presentation-agent",
  "type": "module",
  "private": true,
  "scripts": {
    "slides:generate": "node scripts/generate-slides.mjs",
    "build": "bun run slides:generate && slidev build && rm -f dist/_redirects",
    "dev": "bun run slides:generate && slidev --open",
    "export": "bun run slides:generate && slidev export"
  },
  "dependencies": {
    "@slidev/cli": "^52.11.1",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "playwright-chromium": "^1.59.1"
  }
}
